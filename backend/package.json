{
  "name": "tess-backend",
  "version": "1.0.0",
  "description": "Sales Order Management System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "test:load:etl": "k6 run load-tests/etl-streaming.js",
    "test:integration": "jest src/tests/integration --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^9.0.3",
    "pg-copy-streams": "^6.0.6",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "saxes": "^5.0.1",
    "stream-json": "^1.9.1",
    "unzipper": "^0.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pino": "^7.0.5",
    "@types/stream-json": "^1.7.8",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.0.1",
    "exceljs": "^4.4.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.70.1"
