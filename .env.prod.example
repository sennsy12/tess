# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.prod and fill in all values
# NEVER commit .env.prod to version control!
# ============================================================

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password_here  # Use a strong, unique password
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/tess

# Backend Configuration
NODE_ENV=production
PORT=5000

# JWT Secret - REQUIRED in production (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=your_very_long_random_secret_at_least_32_characters_here

# Admin action key - REQUIRED for privileged user operations (min 16 chars, not a common word)
# Generate with: openssl rand -base64 24
ADMIN_ACTION_KEY=your_secure_admin_action_key_here

# Production safety (leave false in production unless you know what you are doing)
ENABLE_DESTRUCTIVE_ETL=false
ENABLE_SCHEDULER_JOBS=false

# Logging
LOG_LEVEL=info  # Options: fatal, error, warn, info, debug, trace

# Frontend Configuration
VITE_API_URL=https://yourdomain.com/api
VITE_APP_ENV=production
VITE_IDLE_TIMEOUT_SECONDS=1800
VITE_IDLE_WARNING_SECONDS=1680
# Do not enable in production unless performing controlled maintenance
VITE_ALLOW_DESTRUCTIVE_ETL=false
FRONTEND_URL=https://yourdomain.com  # For CORS

# Optional alert delivery (in-app notifications work without these)
ALERT_WEBHOOK_URL=
ETL_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# AI assistant — server-side only; never expose API keys to the browser
ENABLE_ASSISTANT=false
# gemini (cheaper, default) or openai
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Only if ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ASSISTANT_MAX_OUTPUT_TOKENS=500

# ============================================================
# INITIAL ADMIN BOOTSTRAP (first run, when no admin exists yet)
# ============================================================
# Username for the first admin account (default: admin)
ADMIN_USERNAME=admin
# REQUIRED in production if no admin user exists yet (min 12 characters).
# The server refuses to start without it — no default passwords are seeded.
ADMIN_PASSWORD=

# ============================================================
# SECURITY CHECKLIST FOR PRODUCTION
# ============================================================
# [ ] Set ADMIN_PASSWORD before first boot (no admin is seeded anymore)
# [ ] Set strong JWT_SECRET (32+ characters)
# [ ] Set strong database password
# [ ] Configure HTTPS/TLS
# [ ] Set up database backups
# [ ] Configure monitoring/alerting
# [ ] Review rate limits for your traffic volume
# ============================================================
