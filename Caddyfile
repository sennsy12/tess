tessxapp.mooo.com {
    # Compress every response Caddy emits (SPA shell, API JSON). Caddy skips
    # responses that already carry a Content-Encoding, so this composes with
    # nginx's gzip above instead of double-compressing.
    # NOTE: `gzip` only — `zstd` needs Caddy >= 2.8 and this image uses a
    # floating `caddy:2-alpine` tag, so referencing it could break startup.
    encode gzip

    # Reverse proxy for Backend API
    handle /api/* {
        reverse_proxy backend:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    # Reverse proxy for Frontend
    handle {
        reverse_proxy frontend:80
    }

    # NOTE: GET /metrics (Prometheus, no auth) is intentionally not routed.
    # Access logs go to stdout so the docker log driver (with rotation in
    # docker-compose.prod.yml) applies — never to a file inside the container.
    log {
        output stdout
    }
}
