{
  "name": "tess",
  "version": "1.0.0",
  "private": true,
  "description": "TESS - Sales Order Management System (repo-level tooling: git hooks, commitlint, lint-staged)",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "lint-staged": {
    "backend/src/**/*.{ts,tsx,js,cjs}": [
      "eslint --fix --config backend/eslint.config.js"
    ],
    "frontend/src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --config frontend/eslint.config.js"
    ]
  }
}

